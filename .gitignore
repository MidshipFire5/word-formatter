# Локальное виртуальное окружение — создаётся скриптами запуска
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Тесты и инструменты
.pytest_cache/
.coverage
htmlcov/

# Служебный каталог для временных файлов внутри проекта
.tmp/

# Артефакты запуска тестов, если временная папка всё же оказалась в проекте
pytest-of-*/
tmp*.json

# Отчёты, созданные приложением во время ручных проверок
*.report.txt
out/

# Редакторы и ОС
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.swp

# Личные профили оформления и локальные логи
local_profiles/
*.log

# Документы для работы над проектом вместе с ИИ-агентом: остаются
# у разработчика, в публичный репозиторий не попадают.
AGENTS.md
docs/ACCEPTANCE.md
